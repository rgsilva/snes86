.claude/
core-c/build/
snes/build/
core-c/tests/vectors/*.json.gz
core-c/tests/vectors/metadata.json
*.o
*.dylib
*.sfc
*.sym
.DS_Store
releases/
snake_im.zip

# disks/ holds bring-your-own copyrighted DOS software and the generated
# app-matrix test fixture: local-only, never committed. Our own software
# lives in apps/ now; the only tracked file here is mkappmatrix.py.
disks/*
!disks/mkappmatrix.py

# apps: staged image content and the fetched (never redistributed)
# Turbo Pascal 3 live outside git
apps/*/build/
apps/*/hostbuild/
apps/cache/

# apps: the on-machine binaries are BUILD PRODUCTS, rebuilt from source
# by every image build (TP3 / Small-C inside runpc; host nasm for
# gb.com) — never committed.
# (apps/cc/*.EXE is different: a vendored public-domain toolchain.)
apps/view/view.com
apps/ted/ted.com
apps/sokoban/sokoban.com
apps/midi/midplay.com
apps/midi/midconv.com
apps/bench/sieve.com
apps/bench/hello.com
apps/bench/bench.com
apps/java/java.com
apps/java/javac.exe
apps/gb/gb.com

# user/ -> C:\USER: bring-your-own software, never committed
user/*
!user/.gitkeep
__pycache__/
snes/test/shot.lua

# apps/vi: version.c is generated from levee/VERSION at recompile time
apps/vi/version.c
