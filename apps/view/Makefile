# VIEW — BMP/PCX picture viewer. `make stage` fills build/ with exactly
# what ships on C:\VIEW. view.com is a BUILD PRODUCT (no binary is
# committed): it compiles from view.pas with TP3 driven inside runpc —
# see ../tpcompile.sh (TP3 fetched + sha256-pinned by ../fetch_tp3.py).
# The inline machine-code blocks in view.pas are generated by
# mkviewasm.py.
B := build

stage: $(B)/VIEW.COM $(B)/CARD.BMP

view.com: view.pas ../tpcompile.sh
	sh ../tpcompile.sh view view

$(B)/VIEW.COM: view.com
	@mkdir -p $(B)
	cp view.com $@

$(B)/CARD.BMP: mkcard.py
	@mkdir -p $(B)
	python3 mkcard.py $(B)/CARD.BMP

recompile:
	sh ../tpcompile.sh view view
	$(MAKE) stage

clean:
	rm -rf $(B)

.PHONY: stage recompile clean
