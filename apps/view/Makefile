# VIEW — BMP/PCX picture viewer. `make stage` fills build/ with exactly
# what ships on C:\VIEW; `make recompile` rebuilds view.com from source
# (TP3 inside runpc — see ../tpcompile.sh). The inline machine-code
# blocks in view.pas are generated by mkviewasm.py.
B := build

stage: $(B)/VIEW.COM $(B)/CARD.BMP

$(B)/VIEW.COM: view.com
	@mkdir -p $(B)
	cp view.com $@

$(B)/CARD.BMP: mkcard.py
	@mkdir -p $(B)
	python3 mkcard.py $(B)/CARD.BMP

recompile:
	sh ../tpcompile.sh view view
	$(MAKE) stage

clean:
	rm -rf $(B)

.PHONY: stage recompile clean
